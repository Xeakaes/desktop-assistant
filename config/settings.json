{
  "provider": {
    "type": "groq",
    "model": "qwen/qwen3.8-27b"
  },
  "screen_control": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8745
  },
  "permissions": {
    "*": "deny",
    "screenshot": "allow",
    "list_windows": "allow",
    "ocr_screen": "ask",
    "mouse": "ask",
    "keyboard": "ask",
    "focus_window": "ask"
  },
  "agent": {
    "max_tool_calls": 10,
    "tool_timeout_s": 30,
    "model_timeout_s": 60,
    "max_history_images": 1
  },
  "avatar": "base"
}
